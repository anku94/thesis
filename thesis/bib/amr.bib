  shorttitle = {Uintah},
  booktitle = {2010 3rd {{Workshop}} on {{Many-Task Computing}} on {{Grids}} and {{Supercomputers}}},
  author = {Meng, Qingyu and Luitjens, Justin and Berzins, Martin},
