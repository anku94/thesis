@inproceedings{Mitra2014:AccurateApplicationProgress,
  title = {Accurate Application Progress Analysis for Large-Scale Parallel Debugging},
  booktitle = {Proceedings of the 35th {{ACM SIGPLAN Conference}} on {{Programming Language Design}} and {{Implementation}}},
  author = {Mitra, Subrata and Laguna, Ignacio and Ahn, Dong H. and Bagchi, Saurabh and Schulz, Martin and Gamblin, Todd},
