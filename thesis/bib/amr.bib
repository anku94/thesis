@online{Daiss2024:HPX,
  title = {Asynchronous-{{Many-Task Systems}}: {{Challenges}} and {{Opportunities}} -- {{Scaling}} an {{AMR Astrophysics Code}} on {{Exascale}} Machines Using {{Kokkos}} and {{HPX}}},
  shorttitle = {{{HPX}}},
  author = {Daiß, Gregor and Diehl, Patrick and Yan, Jiakun and Holmen, John K. and Gayatri, Rahulkumar and Junghans, Christoph and Straub, Alexander and Hammond, Jeff R. and Marcello, Dominic and Tsuji, Miwako and Pflüger, Dirk and Kaiser, Hartmut},
