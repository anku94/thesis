@article{Hoefl2011:ScalableProcessTopology,
  title = {The Scalable Process Topology Interface of {{MPI}} 2.2},
  author = {Hoefler, Torsten and Rabenseifner, Rolf and Ritzdorf, Hubert and family=Supinski, given=Bronis R., prefix=de, useprefix=true and Thakur, Rajeev and Träff, Jesper Larsson},
