  author = {Bhatele, Abhinav and Titus, Andrew R. and Thiagarajan, Jayaraman J. and Jain, Nikhil and Gamblin, Todd and Bremer, Peer-Timo and Schulz, Martin and Kale, Laxmikant V.},
