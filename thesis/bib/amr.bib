@inproceedings{Rabin2010:NetworkOffloadedHierarchical,
  title = {Network {{Offloaded Hierarchical Collectives Using ConnectX-2}}’s {{CORE-Direct Capabilities}}},
  booktitle = {Recent {{Advances}} in the {{Message Passing Interface}}},
  author = {Rabinovitz, Ishai and Shamis, Pavel and Graham, Richard L. and Bloch, Noam and Shainer, Gilad},
