  author = {Bayatpour, Mohammadreza and Hashmi Maqbool, Jahanzeb and Chakraborty, Sourav and Kandadi Suresh, Kaushik and Ghazimirsaeed, Seyedeh Mahdieh and Ramesh, Bharath and Subramoni, Hari and Panda, Dhabaleswar K.},
  date = {2020-05-22},
