@article{Hu2018:MulticontrollerBasedSoftwareDefined,
  title = {Multi-Controller {{Based Software-Defined Networking}}: {{A Survey}}},
  shorttitle = {Multi-Controller {{Based Software-Defined Networking}}},
  author = {Hu, Tao and Guo, Zehua and Yi, Peng and Baker, Thar and Lan, Julong},
