  shorttitle = {{{MicroTE}}},
  booktitle = {Proceedings of the {{Seventh COnference}} on Emerging {{Networking EXperiments}} and {{Technologies}}},
  author = {Benson, Theophilus and Anand, Ashok and Akella, Aditya and Zhang, Ming},
