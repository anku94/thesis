  author = {Bird, Robert and Tan, Nigel and Luedtke, Scott V. and Harrell, Stephen Lien and Taufer, Michela and Albright, Brian},
  date = {2022-04},
  journaltitle = {IEEE Transactions on Parallel and Distributed Systems},
  volume = {33},
