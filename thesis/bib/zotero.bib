@article{Zhao2021:KLLApproximateQuantile,
  title = {{{KLL}} {\textsuperscript{±}} Approximate Quantile Sketches over Dynamic Datasets},
  author = {Zhao, Fuheng and Maiyya, Sujaya and Wiener, Ryan and Agrawal, Divyakant and Abbadi, Amr El},
  date = {2021-03},
  journaltitle = {Proceedings of the VLDB Endowment},
  shortjournal = {Proc. VLDB Endow.},
  volume = {14},
  number = {7},
