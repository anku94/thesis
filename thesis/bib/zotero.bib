@inproceedings{Mikid2016:TowardsPDESinaMessage-DrivenParadigm,
  title = {Towards {{PDES}} in a {{Message-Driven Paradigm}}: {{A Preliminary Case Study Using Charm}}++},
  shorttitle = {Towards {{PDES}} in a {{Message-Driven Paradigm}}},
  booktitle = {Proceedings of the 2016 {{ACM SIGSIM Conference}} on {{Principles}} of {{Advanced Discrete Simulation}}},
  author = {Mikida, Eric and Jain, Nikhil and Kale, Laxmikant and Gonsiorowski, Elsa and Carothers, Christopher D. and Barnes, Peter D. and Jefferson, David},
  date = {2016-05-15},
  series = {{{SIGSIM-PADS}} '16},
  pages = {99--110},
