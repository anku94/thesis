}

@inproceedings{VanS2009:AMR,
  title = {Scalability Challenges for Massively Parallel {{AMR}} Applications},
  shorttitle = {{{AMR}}},
  booktitle = {2009 {{IEEE International Symposium}} on {{Parallel}} \& {{Distributed Processing}}},
  author = {Van Straalen, Brian and Shalf, John and Ligocki, Terry and Keen, Noel and {Woo-Sun Yang}},
