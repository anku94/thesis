@inproceedings{Bhate2020:PerfVar,
  title = {The {{Case}} of {{Performance Variability}} on {{Dragonfly-based Systems}}},
  shorttitle = {{{PerfVar}}},
  booktitle = {2020 {{IEEE International Parallel}} and {{Distributed Processing Symposium}} ({{IPDPS}})},
