  booktitle = {Proceedings of the 17th {{ACM Workshop}} on {{Hot Topics}} in {{Storage}} and {{File Systems}}},
  author = {Li, Endian and Yi, Shushu and Peng, Li and Li, Qiao and Zhou, Diyu and Wang, Zhenlin and Wang, Xiaolin and Mao, Bo and Luo, Yingwei and Zhou, Ke and Zhang, Jie},
  date = {2025-07-10},
