@article{Feren:ModernizingLongLivedProduction,
  title = {Modernizing a {{Long-Lived Production Physics Code}}},
  author = {Ferenbaugh, Charles and Swaminarayan, Sriram and Aldrich, Chuck},
  abstract = {LANL’s Eulerian Applications Project is modernizing its code base to perform at large scale on Trinity and other future platforms. To make this possible, we are untangling the complicated dependencies that have built up over the years, and dividing the functionality into smaller, self-contained packages. These packages will be well-documented, have well-defined APIs, and be unit-testable. They will allow us to refactor code in individual packages with minimal impact to other parts of the code. We will then be able to work on the optimizations for Trinity and other advanced architectures. This poster will describe the packagization strategy, our progress to date, initial optimization results, and future plans.},
