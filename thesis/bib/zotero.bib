@article{Dunni2020:AdaptiveMeshRefinement,
  title = {Adaptive Mesh Refinement in the Fast Lane},
  author = {Dunning, D. and Marts, W. and Robey, R. W. and Bridges, P.},
  date = {2020-04-01},
  journaltitle = {Journal of Computational Physics},
  shortjournal = {Journal of Computational Physics},
