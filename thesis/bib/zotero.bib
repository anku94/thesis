@article{Katah2020:VolitionalControlofPiloerection,
  title = {Volitional {{Control}} of {{Piloerection}}: {{Objective Evidence}} and {{Its Potential Utility}} in {{Neuroscience Research}}},
  shorttitle = {Volitional {{Control}} of {{Piloerection}}},
  author = {Katahira, Kenji and Kawakami, Ai and Tomita, Akitoshi and Nagata, Noriko},
  date = {2020-06-05},
  journaltitle = {Frontiers in Neuroscience},
  shortjournal = {Front. Neurosci.},
