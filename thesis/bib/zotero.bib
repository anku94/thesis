  booktitle = {Proceedings of the 2016 {{ACM SIGCOMM Conference}}},
  author = {Guo, Chuanxiong and Wu, Haitao and Deng, Zhong and Soni, Gaurav and Ye, Jianxi and Padhye, Jitu and Lipshteyn, Marina},
