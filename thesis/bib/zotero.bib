  author = {family=Mey, given=Dieter, prefix=an, useprefix=false and Biersdorf, Scott and Bischof, Christian and Diethelm, Kai and Eschweiler, Dominic and Gerndt, Michael and Knüpfer, Andreas and Lorenz, Daniel and Malony, Allen and Nagel, Wolfgang E. and Oleynik, Yury and Rössel, Christian and Saviankou, Pavel and Schmidl, Dirk and Shende, Sameer and Wagner, Michael and Wesarg, Bert and Wolf, Felix},
