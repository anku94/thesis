  file = {/Users/schwifty/Library/CloudStorage/GoogleDrive-ankushj@andrew.cmu.edu/My Drive/MiscNotes/08 Zotero/RangeQueries/2020_childs_et_al_a_terminology_for_in_situ_visualization_and_analysis_systems.pdf}
